{
  "name": "momoya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:local": "wrangler d1 execute momoya --local --file=schema.sql",
    "api": "vite build && wrangler pages dev dist --port 8788",
    "test:api": "node test-api.mjs",
    "deploy": "vite build && wrangler pages deploy dist --project-name momoya --branch main --commit-dirty=true"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "vite": "^8.3.2",
    "wrangler": "^4.152.0"
  }
}
